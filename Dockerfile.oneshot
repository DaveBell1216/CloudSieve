FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY Seive2.OneShot/Seive2.OneShot.csproj Seive2.OneShot/
RUN dotnet restore Seive2.OneShot/Seive2.OneShot.csproj
COPY Seive2.OneShot/ Seive2.OneShot/
RUN dotnet publish Seive2.OneShot/Seive2.OneShot.csproj --configuration Release --no-restore --output /app/publish

FROM mcr.microsoft.com/dotnet/runtime:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish/ ./
USER $APP_UID
ENTRYPOINT ["dotnet", "Seive2.OneShot.dll"]
